{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Audio Output Switcher",
  "Version": "2.0.0.0",
  "Author": "Welsh",
  "URL": "https://github.com/brendanwelsh/streamdeck-audioswap",
  "Description": "Scroll through your Windows audio outputs on a Stream Deck+ dial (rotate) and push to switch the default playback device.",
  "Category": "Audio Output Switcher",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin-icon",
  "SDKVersion": 2,
  "CodePath": "plugin.js",
  "Nodejs": { "Version": "24", "Debug": "enabled" },
  "Software": { "MinimumVersion": "6.4" },
  "OS": [ { "Platform": "windows", "MinimumVersion": "10" } ],
  "Actions": [
    {
      "Name": "Audio Output",
      "UUID": "com.welsh.audioswap.output",
      "Icon": "imgs/action-audio",
      "PropertyInspectorPath": "pi/audio.html",
      "Tooltip": "Rotate to scroll your audio outputs, push to set the highlighted one as default",
      "Controllers": ["Encoder"],
      "Encoder": {
        "layout": "layouts/audiodial.json",
        "TriggerDescription": { "Rotate": "Scroll outputs", "Push": "Set highlighted output" }
      },
      "States": [ { "Image": "imgs/key", "TitleAlignment": "middle" } ]
    }
  ]
}
